NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: production base URL for canonical links, robots and sitemap.
NEXT_PUBLIC_SITE_URL=

# Manual Mercado Pago links. Leave empty to show WhatsApp/CoDi fallback.
NEXT_PUBLIC_MP_LINK_BASIC=
NEXT_PUBLIC_MP_LINK_PRO=
NEXT_PUBLIC_MP_LINK_PREMIUM=

# Public CoDi QR image URLs or paths.
NEXT_PUBLIC_CODI_QR_BASIC=
NEXT_PUBLIC_CODI_QR_PRO=
NEXT_PUBLIC_CODI_QR_PREMIUM=
NEXT_PUBLIC_CODI_QR_GENERAL=

# AZC local lead capture pilot. Server-side variables are preferred in Next.js.
# If AZC runs on port 3000, run Casero on another local port for end-to-end testing.
AZC_LEADS_ENDPOINT=http://localhost:3000/api/public/leads
AZC_PUBLIC_LEADS_API_KEY=valor_real_en_vercel_o_entorno_seguro
AZC_CASERO_REQUESTS_URL=https://azc-crm.marketinmobiliario.mx/api/public/casero/solicitudes

# Backward-compatible local fallback only. Do not expose real API keys in browser variables.
VITE_AZC_LEADS_ENDPOINT=http://localhost:3000/api/public/leads
VITE_AZC_PUBLIC_LEADS_API_KEY=change-me-local-key
